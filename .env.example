# Шаблон. Реальный файл лежит в %USERPROFILE%\.avatars\secrets.env
# и НИКОГДА не попадает в репозиторий.
# Путь можно переопределить переменной AVATARS_ENV_FILE.

# --- модели ---------------------------------------------------------------

KANDINSKY_BASE_URL=https://kandinskyapi.ru
KANDINSKY_TOKEN=

H3_BASE_URL=http://<адрес инстанса H3>
H3_API_KEY=

# --- мини-приложение в MAX ------------------------------------------------

# Токен бота мини-приложения. Строка целиком, без кавычек и без пробелов.
# Этим же токеном проверяется подпись initData, поэтому он должен быть
# от того самого бота, к которому привязан адрес в business.max.ru/self.
MAX_BOT_TOKEN=

# Публичный адрес мини-приложения. Тот же, что привязан в кабинете.
# Локально не нужен — вебвью всё равно открывается только по HTTPS.
MAX_WEBAPP_URL=

# Пропускать запросы без подписи. ТОЛЬКО на локальной машине.
# На сервере значения быть не должно вовсе: деплой считается неуспешным,
# если /api/health вернул dev_unsigned: true.
MINIAPP_DEV_ALLOW_UNSIGNED=1

# Поднимать ли чат-часть. Один токен = один процесс long polling:
# если бот уже крутится на сервере, локально ставим 0, иначе апдейты
# начнут делиться между двумя процессами и бот будет «иногда не отвечать».
MINIAPP_CHAT_ENABLED=1
